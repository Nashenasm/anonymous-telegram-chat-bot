{
  
  "version": 2,
  
  "builds": [
    
    { "src": "api/webhook.js", "use": "@vercel/node" },
    
    { "src": "api/admin.js", "use": "@vercel/node" }
    
  ],
  
  "routes": [
    
    { "src": "/api/webhook", "dest": "/api/webhook.js" },
    
    { "src": "/api/admin", "dest": "/api/admin.js" }
    
  ],
  
  "functions": {
    
    "api/webhook.js": { "maxDuration": 30 },
    
    "api/admin.js": { "maxDuration": 15 }
    
  }
  
}















